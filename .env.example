# Local defaults only. Copy to `.env` before `docker compose up`.
# Do not use these values in production.

DOMAIN=localhost
# Required by compose.deploy.yml for Let's Encrypt notifications.
LETSENCRYPT_EMAIL=ops@example.com
PROJECT_NAME=Hvostun
FASTAPI_ENV=development
SECRET_KEY=local-dev-secret-change-me
# Unset locally (cookie lasts 8 days). Staging and production default to
# 12 hours unless this variable is set.
# ACCESS_TOKEN_EXPIRE_MINUTES=720
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=local-dev-password
POSTGRES_PASSWORD=local-dev-postgres
DATABASE_URL=postgresql://postgres:local-dev-postgres@localhost:5432/hvostun_development
# pytest sets FASTAPI_ENV=test and uses hvostun_test (created on first run)
SMTP_HOST=
EMAILS_FROM_EMAIL=info@example.com
SENTRY_DSN=
